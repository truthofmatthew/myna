{
  "manifest_version": 3,
  "name": "Myna",
  "version": "0.1.0",
  "description": "Use your Android phone's camera and mic in Google Meet.",
  "content_scripts": [
    {
      "matches": ["https://meet.google.com/*"],
      "js": ["myna.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
