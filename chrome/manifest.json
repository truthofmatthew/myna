{
  "manifest_version": 3,
  "name": "Myna",
  "version": "0.2.1",
  "description": "Use your Android phone's camera and mic in Google Meet.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "host_permissions": [
    "http://127.0.0.1:8737/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://meet.google.com/*"
      ],
      "js": [
        "myna.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://meet.google.com/*"
      ],
      "js": [
        "host.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "relay.html"
      ],
      "matches": [
        "https://meet.google.com/*"
      ]
    }
  ]
}
